{
  "manifest_version": 3,
  "name": "DealFlow x Shopify",
  "version": "1.0.0",
  "description": "Envía los pedidos de tu panel de Shopify a DealFlow con un clic.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "DealFlow x Shopify",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://app.dealflow.sbs/*",
    "https://admin.shopify.com/*",
    "https://*.myshopify.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://admin.shopify.com/store/*",
        "https://*.myshopify.com/admin/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/icon-32.png"
      ],
      "matches": [
        "https://admin.shopify.com/*",
        "https://*.myshopify.com/*"
      ]
    }
  ]
}
