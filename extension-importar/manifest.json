{
  "manifest_version": 3,
  "name": "DealFlow · Importar productos",
  "version": "1.1.0",
  "description": "Importa a DealFlow tus productos de otros bots (LucidSales / Lucid Bot) con fotos, variantes, combos y mensaje inicial.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "DealFlow · Importar productos",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" }
  },
  "permissions": ["storage"],
  "host_permissions": ["https://app.dealflow.sbs/*", "https://panel.lucidsales.co/*", "https://*/*"],
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "content_scripts": [
    { "matches": ["https://panel.lucidsales.co/*"], "js": ["content.js"], "run_at": "document_idle" }
  ],
  "web_accessible_resources": [
    { "resources": ["icons/icon-32.png"], "matches": ["https://panel.lucidsales.co/*"] }
  ],
  "browser_specific_settings": {
    "gecko": { "id": "importar-productos@dealflow.sbs", "strict_min_version": "121.0" }
  }
}
